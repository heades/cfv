cabal-version:      3.14
name:               cfv
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Harley D. Eades III
maintainer:         harley@harleyeades.com
-- copyright:
category:           Development
build-type:         Simple
extra-doc-files:
    CHANGELOG.md
    README.md

-- extra-source-files:

common extensions
    default-language: GHC2021
    default-extensions:
        InstanceSigs
        OverloadedStrings

common ghc-options
    ghc-options: -Wall -Widentities

common rts-options
    ghc-options: -rtsopts -threaded "-with-rtsopts=-N"

library
    import:           extensions
    import:           ghc-options
    exposed-modules:  
        Configuration.Cfv
        Configuration.Cfv.AST
        Configuration.Cfv.Parser
        Configuration.Cfv.Shell        
    -- other-modules:
    -- other-extensions:
    build-depends:    
        base ^>= 4.22.0.0
       ,megaparsec
       ,text
       ,bytestring
       ,containers
       ,filepath
       ,process
    hs-source-dirs:   src
    default-language: Haskell2010

executable cfv
    import:           extensions
    import:           ghc-options
    import:           rts-options
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.22.0.0,
        cfv

    hs-source-dirs:   app
    default-language: Haskell2010

test-suite cfv-test
    import:           extensions
    import:           ghc-options
    import:           rts-options
    default-language: Haskell2010
    other-modules:
        CfvSpec
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-tool-depends: 
        hspec-discover:hspec-discover
    build-depends:
        base ^>=4.22.0.0,
        hspec,
        cfv    
